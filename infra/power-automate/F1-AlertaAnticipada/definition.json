{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "vu_SiteUrl (vu_SiteUrl)": {
          "defaultValue": "https://biomont.sharepoint.com/sites/VerificacionUso",
          "type": "String",
          "metadata": {
            "schemaName": "vu_SiteUrl",
            "description": "URL del sitio SharePoint de Verificacion de uso"
          }
        },
        "vu_ListaVerificaciones (vu_ListaVerificaciones)": {
          "defaultValue": "VU_Verificaciones",
          "type": "String",
          "metadata": {
            "schemaName": "vu_ListaVerificaciones",
            "description": "Nombre (o GUID) de la lista VU_Verificaciones"
          }
        },
        "vu_ListaNotificaciones (vu_ListaNotificaciones)": {
          "defaultValue": "VU_Notificaciones",
          "type": "String",
          "metadata": {
            "schemaName": "vu_ListaNotificaciones",
            "description": "Nombre (o GUID) de la lista VU_Notificaciones"
          }
        }
      },
      "triggers": {
        "Recurrencia_diaria_0700_Lima": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "SA Pacific Standard Time",
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                0
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Hoy_Lima": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'SA Pacific Standard Time'), 'yyyy-MM-dd')"
        },
        "Obtener_verificaciones_a_alertar": {
          "runAfter": {
            "Hoy_Lima": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('vu_SiteUrl (vu_SiteUrl)')",
              "table": "@parameters('vu_ListaVerificaciones (vu_ListaVerificaciones)')",
              "$filter": "Estado eq 'Programada' and FechaAlerta le '@{outputs('Hoy_Lima')}T23:59:59Z' and AlertaEnviada eq 0"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Para_cada_verificacion": {
          "foreach": "@body('Obtener_verificaciones_a_alertar')?['value']",
          "actions": {
            "Enviar_alerta_al_responsable": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@{items('Para_cada_verificacion')?['Responsable/Email']}",
                  "emailMessage/Subject": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['Title']} (@{items('Para_cada_verificacion')?['Solucion/Value']}) programada para el @{formatDateTime(take(string(items('Para_cada_verificacion')?['FechaObjetivo']), 10), 'dd/MM/yyyy')}",
                  "emailMessage/Body": "<p>Hola @{items('Para_cada_verificacion')?['Responsable/DisplayName']}:</p><p>La verificación de uso <b>@{items('Para_cada_verificacion')?['Title']}</b> de la solución <b>@{items('Para_cada_verificacion')?['Solucion/Value']}</b> está programada para el <b>@{formatDateTime(take(string(items('Para_cada_verificacion')?['FechaObjetivo']), 10), 'dd/MM/yyyy')}</b>.</p><ul><li>Entrevistas previstas: @{items('Para_cada_verificacion')?['EntrevistasPrevistas']}</li><li>Modalidad: @{items('Para_cada_verificacion')?['Modalidad/Value']}</li><li>Anticipación del aviso: @{items('Para_cada_verificacion')?['DiasAnticipacion']} días</li></ul><p>Coordine las entrevistas y registre el avance en la app <i>Verificación de uso</i>. Este aviso es solo para usted: la aprobadora no recibe nada hasta que finalice la verificación (RN-06).</p>",
                  "emailMessage/Importance": "Normal"
                }
              }
            },
            "Marcar_alerta_enviada": {
              "runAfter": {
                "Enviar_alerta_al_responsable": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('vu_SiteUrl (vu_SiteUrl)')",
                  "table": "@parameters('vu_ListaVerificaciones (vu_ListaVerificaciones)')",
                  "id": "@items('Para_cada_verificacion')?['ID']",
                  "item/Title": "@items('Para_cada_verificacion')?['Title']",
                  "item/Solucion/Id": "@items('Para_cada_verificacion')?['Solucion/Id']",
                  "item/Responsable/Claims": "@items('Para_cada_verificacion')?['Responsable/Claims']",
                  "item/FechaObjetivo": "@items('Para_cada_verificacion')?['FechaObjetivo']",
                  "item/DiasAnticipacion": "@items('Para_cada_verificacion')?['DiasAnticipacion']",
                  "item/FechaAlerta": "@items('Para_cada_verificacion')?['FechaAlerta']",
                  "item/AlertaEnviada": true,
                  "item/EntrevistasPrevistas": "@items('Para_cada_verificacion')?['EntrevistasPrevistas']",
                  "item/EntrevistasCompletas": "@items('Para_cada_verificacion')?['EntrevistasCompletas']",
                  "item/Modalidad/Value": "@items('Para_cada_verificacion')?['Modalidad/Value']",
                  "item/Estado/Value": "@items('Para_cada_verificacion')?['Estado/Value']",
                  "item/NotificarAlFinalizar": "@items('Para_cada_verificacion')?['NotificarAlFinalizar']"
                }
              }
            },
            "Registrar_notificacion_enviada": {
              "runAfter": {
                "Enviar_alerta_al_responsable": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('vu_SiteUrl (vu_SiteUrl)')",
                  "table": "@parameters('vu_ListaNotificaciones (vu_ListaNotificaciones)')",
                  "item/Title": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['Title']} (@{items('Para_cada_verificacion')?['Solucion/Value']}) programada para el @{formatDateTime(take(string(items('Para_cada_verificacion')?['FechaObjetivo']), 10), 'dd/MM/yyyy')}",
                  "item/Verificacion/Id": "@items('Para_cada_verificacion')?['ID']",
                  "item/TipoNotificacion/Value": "Alerta anticipada",
                  "item/Destinatario/Claims": "@{items('Para_cada_verificacion')?['Responsable/Email']}",
                  "item/Canal/Value": "Correo",
                  "item/FechaEnvio": "@utcNow()",
                  "item/EstadoEnvio/Value": "Enviada"
                }
              }
            },
            "Registrar_notificacion_error": {
              "runAfter": {
                "Enviar_alerta_al_responsable": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('vu_SiteUrl (vu_SiteUrl)')",
                  "table": "@parameters('vu_ListaNotificaciones (vu_ListaNotificaciones)')",
                  "item/Title": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['Title']} (@{items('Para_cada_verificacion')?['Solucion/Value']}) programada para el @{formatDateTime(take(string(items('Para_cada_verificacion')?['FechaObjetivo']), 10), 'dd/MM/yyyy')}",
                  "item/Verificacion/Id": "@items('Para_cada_verificacion')?['ID']",
                  "item/TipoNotificacion/Value": "Alerta anticipada",
                  "item/Destinatario/Claims": "@{items('Para_cada_verificacion')?['Responsable/Email']}",
                  "item/Canal/Value": "Correo",
                  "item/FechaEnvio": "@utcNow()",
                  "item/EstadoEnvio/Value": "Error"
                }
              }
            }
          },
          "runAfter": {
            "Obtener_verificaciones_a_alertar": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "type": "Foreach"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
