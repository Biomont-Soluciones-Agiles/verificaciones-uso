{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Recurrencia_diaria_0700_Lima": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "SA Pacific Standard Time",
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                0
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Hoy_Lima": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@convertFromUtc(utcNow(), 'SA Pacific Standard Time', 'yyyy-MM-dd')"
        },
        "Listar_verificaciones_a_alertar": {
          "runAfter": {
            "Hoy_Lima": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_verificacions",
              "$select": "vu_verificacionid,vu_name,vu_fechaobjetivo,vu_diasanticipacion,vu_entrevistasprevistas,vu_modalidad,_vu_solucionid_value,_vu_responsableid_value",
              "$filter": "vu_estado eq 100000001 and vu_fechaalerta le @{outputs('Hoy_Lima')} and vu_alertaenviada eq false"
            }
          }
        },
        "Para_cada_verificacion": {
          "foreach": "@body('Listar_verificaciones_a_alertar')?['value']",
          "actions": {
            "Leer_responsable": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@items('Para_cada_verificacion')?['_vu_responsableid_value']",
                  "$select": "systemuserid,fullname,internalemailaddress,domainname"
                }
              }
            },
            "Leer_solucion": {
              "runAfter": {
                "Leer_responsable": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_solucions",
                  "recordId": "@items('Para_cada_verificacion')?['_vu_solucionid_value']",
                  "$select": "vu_name"
                }
              }
            },
            "Enviar_alerta_al_responsable": {
              "runAfter": {
                "Leer_solucion": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@{coalesce(body('Leer_responsable')?['internalemailaddress'], body('Leer_responsable')?['domainname'])}",
                  "emailMessage/Subject": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['vu_name']} (@{body('Leer_solucion')?['vu_name']}) programada para el @{formatDateTime(items('Para_cada_verificacion')?['vu_fechaobjetivo'], 'dd/MM/yyyy')}",
                  "emailMessage/Body": "<p>Hola @{body('Leer_responsable')?['fullname']}:</p><p>La verificación de uso <b>@{items('Para_cada_verificacion')?['vu_name']}</b> de la solución <b>@{body('Leer_solucion')?['vu_name']}</b> está programada para el <b>@{formatDateTime(items('Para_cada_verificacion')?['vu_fechaobjetivo'], 'dd/MM/yyyy')}</b>.</p><ul><li>Entrevistas previstas: @{items('Para_cada_verificacion')?['vu_entrevistasprevistas']}</li><li>Modalidad: @{items('Para_cada_verificacion')?['vu_modalidad@OData.Community.Display.V1.FormattedValue']}</li><li>Anticipación del aviso: @{items('Para_cada_verificacion')?['vu_diasanticipacion']} días</li></ul><p>Coordine las entrevistas y registre el avance en la app <i>Verificación de uso</i>. Este aviso es solo para usted: la aprobadora no recibe nada hasta que finalice la verificación (RN-06).</p>",
                  "emailMessage/Importance": "Normal"
                }
              }
            },
            "Marcar_alerta_enviada": {
              "runAfter": {
                "Enviar_alerta_al_responsable": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_verificacions",
                  "recordId": "@items('Para_cada_verificacion')?['vu_verificacionid']",
                  "item/vu_alertaenviada": true
                }
              }
            },
            "Registrar_notificacion_enviada": {
              "runAfter": {
                "Marcar_alerta_enviada": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_notificacions",
                  "item/vu_name": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['vu_name']} (@{body('Leer_solucion')?['vu_name']}) programada para el @{formatDateTime(items('Para_cada_verificacion')?['vu_fechaobjetivo'], 'dd/MM/yyyy')}",
                  "item/vu_tiponotificacion": 100000000,
                  "item/vu_DestinatarioId@odata.bind": "/systemusers(@{items('Para_cada_verificacion')?['_vu_responsableid_value']})",
                  "item/vu_canal": 100000000,
                  "item/vu_fechaenvio": "@utcNow()",
                  "item/vu_estadoenvio": 100000000,
                  "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{items('Para_cada_verificacion')?['vu_verificacionid']})"
                }
              }
            },
            "Registrar_notificacion_error": {
              "runAfter": {
                "Enviar_alerta_al_responsable": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_notificacions",
                  "item/vu_name": "Alerta anticipada: verificación de uso @{items('Para_cada_verificacion')?['vu_name']} (@{body('Leer_solucion')?['vu_name']}) programada para el @{formatDateTime(items('Para_cada_verificacion')?['vu_fechaobjetivo'], 'dd/MM/yyyy')}",
                  "item/vu_tiponotificacion": 100000000,
                  "item/vu_DestinatarioId@odata.bind": "/systemusers(@{items('Para_cada_verificacion')?['_vu_responsableid_value']})",
                  "item/vu_canal": 100000000,
                  "item/vu_fechaenvio": "@utcNow()",
                  "item/vu_estadoenvio": 100000001,
                  "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{items('Para_cada_verificacion')?['vu_verificacionid']})"
                }
              }
            }
          },
          "runAfter": {
            "Listar_verificaciones_a_alertar": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "type": "Foreach"
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
