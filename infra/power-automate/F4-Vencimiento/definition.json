{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Recurrencia_semanal_lunes_0700_Lima": {
          "recurrence": {
            "frequency": "Week",
            "interval": 1,
            "timeZone": "SA Pacific Standard Time",
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                0
              ],
              "weekDays": [
                "Monday"
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Hoy_Lima": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@convertFromUtc(utcNow(), 'SA Pacific Standard Time', 'yyyy-MM-dd')"
        },
        "Limite_30_dias": {
          "runAfter": {
            "Hoy_Lima": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@addDays(outputs('Hoy_Lima'), 30, 'yyyy-MM-dd')"
        },
        "Listar_soluciones_por_vencer": {
          "runAfter": {
            "Limite_30_dias": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_solucions",
              "$select": "vu_solucionid,vu_name,vu_proximavu,vu_estadovu,_vu_responsableid_value",
              "$filter": "statecode eq 0 and vu_proximavu ne null and vu_proximavu le @{outputs('Limite_30_dias')}"
            }
          }
        },
        "Para_cada_solucion": {
          "foreach": "@body('Listar_soluciones_por_vencer')?['value']",
          "actions": {
            "Buscar_verificacion_activa": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_verificacions",
                  "$select": "vu_verificacionid",
                  "$filter": "_vu_solucionid_value eq @{items('Para_cada_solucion')?['vu_solucionid']} and vu_estado ne 100000007 and vu_estado ne 100000008",
                  "$top": 1
                }
              }
            },
            "Si_no_hay_verificacion_activa": {
              "actions": {
                "Dias_para_vencer": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@div(sub(ticks(concat(items('Para_cada_solucion')?['vu_proximavu'], 'T00:00:00Z')), ticks(concat(outputs('Hoy_Lima'), 'T00:00:00Z'))), 864000000000)"
                },
                "Si_vencida_y_no_Pendiente": {
                  "actions": {
                    "Marcar_EstadoVU_Pendiente": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "vu_solucions",
                          "recordId": "@items('Para_cada_solucion')?['vu_solucionid']",
                          "item/vu_estadovu": 100000000
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Dias_para_vencer": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "less": [
                          "@outputs('Dias_para_vencer')",
                          0
                        ]
                      },
                      {
                        "not": {
                          "equals": [
                            "@items('Para_cada_solucion')?['vu_estadovu']",
                            100000000
                          ]
                        }
                      }
                    ]
                  },
                  "type": "If",
                  "else": {
                    "actions": {}
                  }
                },
                "Si_tiene_responsable": {
                  "type": "If",
                  "description": "El catálogo importado puede no tener responsable: se marca Pendiente igual, pero no hay a quién avisar.",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@empty(items('Para_cada_solucion')?['_vu_responsableid_value'])",
                            true
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Leer_responsable": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "GetItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "systemusers",
                          "recordId": "@items('Para_cada_solucion')?['_vu_responsableid_value']",
                          "$select": "systemuserid,fullname,internalemailaddress,domainname"
                        }
                      }
                    },
                    "Enviar_recordatorio": {
                      "runAfter": {
                        "Leer_responsable": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/To": "@{coalesce(body('Leer_responsable')?['internalemailaddress'], body('Leer_responsable')?['domainname'])}",
                          "emailMessage/Subject": "@{if(less(outputs('Dias_para_vencer'), 0), 'Verificación de uso vencida', 'Verificación de uso por vencer')}: @{items('Para_cada_solucion')?['vu_name']} (@{formatDateTime(items('Para_cada_solucion')?['vu_proximavu'], 'dd/MM/yyyy')})",
                          "emailMessage/Body": "<p>Hola @{body('Leer_responsable')?['fullname']}:</p><p>La verificación de uso de la solución <b>@{items('Para_cada_solucion')?['vu_name']}</b> @{if(less(outputs('Dias_para_vencer'), 0), 'venció el', 'vence el')} <b>@{formatDateTime(items('Para_cada_solucion')?['vu_proximavu'], 'dd/MM/yyyy')}</b>@{if(less(outputs('Dias_para_vencer'), 0), '', concat(' (en ', string(outputs('Dias_para_vencer')), ' días)'))} y no tiene ninguna verificación activa.</p><p>Programe una nueva verificación desde la app <i>Verificación de uso</i>.</p>",
                          "emailMessage/Importance": "Normal"
                        }
                      }
                    },
                    "Registrar_recordatorio_enviado": {
                      "runAfter": {
                        "Enviar_recordatorio": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "vu_notificacions",
                          "item/vu_name": "@{if(less(outputs('Dias_para_vencer'), 0), 'Verificación de uso vencida', 'Verificación de uso por vencer')}: @{items('Para_cada_solucion')?['vu_name']} (@{formatDateTime(items('Para_cada_solucion')?['vu_proximavu'], 'dd/MM/yyyy')})",
                          "item/vu_tiponotificacion": 100000003,
                          "item/vu_DestinatarioId@odata.bind": "/systemusers(@{items('Para_cada_solucion')?['_vu_responsableid_value']})",
                          "item/vu_canal": 100000000,
                          "item/vu_fechaenvio": "@utcNow()",
                          "item/vu_estadoenvio": 100000000,
                          "item/vu_SolucionId@odata.bind": "/vu_solucions(@{items('Para_cada_solucion')?['vu_solucionid']})"
                        }
                      }
                    },
                    "Registrar_recordatorio_error": {
                      "runAfter": {
                        "Enviar_recordatorio": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "vu_notificacions",
                          "item/vu_name": "@{if(less(outputs('Dias_para_vencer'), 0), 'Verificación de uso vencida', 'Verificación de uso por vencer')}: @{items('Para_cada_solucion')?['vu_name']} (@{formatDateTime(items('Para_cada_solucion')?['vu_proximavu'], 'dd/MM/yyyy')})",
                          "item/vu_tiponotificacion": 100000003,
                          "item/vu_DestinatarioId@odata.bind": "/systemusers(@{items('Para_cada_solucion')?['_vu_responsableid_value']})",
                          "item/vu_canal": 100000000,
                          "item/vu_fechaenvio": "@utcNow()",
                          "item/vu_estadoenvio": 100000001,
                          "item/vu_SolucionId@odata.bind": "/vu_solucions(@{items('Para_cada_solucion')?['vu_solucionid']})"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Si_vencida_y_no_Pendiente": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Buscar_verificacion_activa": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@length(body('Buscar_verificacion_activa')?['value'])",
                      0
                    ]
                  }
                ]
              },
              "type": "If",
              "else": {
                "actions": {}
              }
            }
          },
          "runAfter": {
            "Listar_soluciones_por_vencer": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "type": "Foreach"
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
