{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Al_pasar_una_verificacion_a_En_revision": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "vu_verificacion",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "vu_estado",
              "subscriptionRequest/filterexpression": "vu_estado eq 100000004",
              "subscriptionRequest/runas": 3
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 25
            }
          }
        }
      },
      "actions": {
        "Inicializar_varEstadoFinal": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varEstadoFinal",
                "type": "integer",
                "value": 100000004
              }
            ]
          }
        },
        "Inicializar_varMotivoDevolucion": {
          "runAfter": {
            "Inicializar_varEstadoFinal": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varMotivoDevolucion",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Leer_verificacion": {
          "runAfter": {
            "Inicializar_varMotivoDevolucion": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_verificacions",
              "recordId": "@triggerOutputs()?['body/vu_verificacionid']",
              "$select": "vu_verificacionid,vu_name,vu_estado,vu_entrevistasprevistas,vu_indiceadopcion,vu_resultado,vu_sustentoglobal,vu_oportunidadesconsolidadas,vu_recomendacionesconsolidadas,_vu_solucionid_value,_vu_responsableid_value,_vu_aprobadorpilotoid_value"
            }
          }
        },
        "Listar_aprobaciones_en_curso": {
          "runAfter": {
            "Leer_verificacion": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_aprobacions",
              "$select": "vu_aprobacionid",
              "$filter": "_vu_verificacionid_value eq @{triggerOutputs()?['body/vu_verificacionid']} and vu_decision eq 100000000 and vu_fechasolicitud gt @{formatDateTime(addDays(utcNow(), -14), 'yyyy-MM-ddTHH:mm:ssZ')}",
              "$top": 1
            }
          }
        },
        "Si_ya_no_esta_En_revision_o_hay_aprobacion_en_curso": {
          "actions": {
            "Terminar_sin_cambios": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "runAfter": {
            "Listar_aprobaciones_en_curso": [
              "Succeeded"
            ]
          },
          "expression": {
            "or": [
              {
                "not": {
                  "equals": [
                    "@body('Leer_verificacion')?['vu_estado']",
                    100000004
                  ]
                }
              },
              {
                "greater": [
                  "@length(body('Listar_aprobaciones_en_curso')?['value'])",
                  0
                ]
              }
            ]
          },
          "type": "If",
          "else": {
            "actions": {}
          }
        },
        "Listar_entrevistas_completas": {
          "runAfter": {
            "Si_ya_no_esta_En_revision_o_hay_aprobacion_en_curso": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_entrevistas",
              "$select": "vu_entrevistaid",
              "$filter": "_vu_verificacionid_value eq @{triggerOutputs()?['body/vu_verificacionid']} and vu_estadoentrevista eq 100000002"
            }
          }
        },
        "Leer_solucion": {
          "runAfter": {
            "Listar_entrevistas_completas": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_solucions",
              "recordId": "@body('Leer_verificacion')?['_vu_solucionid_value']",
              "$select": "vu_name,vu_periodicidadmeses"
            }
          }
        },
        "Leer_responsable": {
          "runAfter": {
            "Leer_solucion": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "recordId": "@body('Leer_verificacion')?['_vu_responsableid_value']",
              "$select": "systemuserid,fullname,internalemailaddress,domainname"
            }
          }
        },
        "Datos_RN07": {
          "runAfter": {
            "Leer_responsable": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "codigo": "@body('Leer_verificacion')?['vu_name']",
            "solucion": "@body('Leer_solucion')?['vu_name']",
            "completas": "@length(body('Listar_entrevistas_completas')?['value'])",
            "previstas": "@body('Leer_verificacion')?['vu_entrevistasprevistas']",
            "responsableId": "@body('Leer_verificacion')?['_vu_responsableid_value']",
            "responsable": "@coalesce(body('Leer_responsable')?['internalemailaddress'], body('Leer_responsable')?['domainname'])",
            "responsableNombre": "@body('Leer_responsable')?['fullname']",
            "aprobadorPilotoId": "@coalesce(body('Leer_verificacion')?['_vu_aprobadorpilotoid_value'], '')"
          }
        },
        "Si_cumple_RN07": {
          "actions": {
            "Leer_aprobador_Piloto": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@outputs('Datos_RN07')?['aprobadorPilotoId']",
                  "$select": "systemuserid,fullname,internalemailaddress,domainname"
                }
              }
            },
            "Aprobador_Piloto": {
              "runAfter": {
                "Leer_aprobador_Piloto": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "id": "@body('Leer_aprobador_Piloto')?['systemuserid']",
                "email": "@coalesce(body('Leer_aprobador_Piloto')?['internalemailaddress'], body('Leer_aprobador_Piloto')?['domainname'])",
                "nombre": "@body('Leer_aprobador_Piloto')?['fullname']"
              }
            },
            "Scope_Nivel_Piloto": {
              "actions": {
                "Crear_aprobacion_Piloto": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_aprobacions",
                      "item/vu_name": "@{outputs('Datos_RN07')?['codigo']} · Aprobación",
                      "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{triggerOutputs()?['body/vu_verificacionid']})",
                      "item/vu_nivel": 100000000,
                      "item/vu_AprobadorId@odata.bind": "/systemusers(@{outputs('Aprobador_Piloto')?['id']})",
                      "item/vu_decision": 100000000,
                      "item/vu_fechasolicitud": "@utcNow()"
                    }
                  }
                },
                "Solicitar_aprobacion_Piloto": {
                  "runAfter": {
                    "Crear_aprobacion_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "limit": {
                    "timeout": "P14D"
                  },
                  "type": "OpenApiConnectionWebhook",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_approvals",
                      "operationId": "StartAndWaitForAnApproval",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                    },
                    "parameters": {
                      "approvalType": "CustomResponse",
                      "WebhookApprovalCreationInput/title": "Verificación de uso @{outputs('Datos_RN07')?['codigo']} · @{outputs('Datos_RN07')?['solucion']}",
                      "WebhookApprovalCreationInput/responseOptions": [
                        "Aprobar",
                        "Observar",
                        "Rechazar"
                      ],
                      "WebhookApprovalCreationInput/assignedTo": "@{outputs('Aprobador_Piloto')?['email']}",
                      "WebhookApprovalCreationInput/details": "**Verificación:** @{outputs('Datos_RN07')?['codigo']}\n\n**Solución:** @{outputs('Datos_RN07')?['solucion']}\n\n**Responsable:** @{outputs('Datos_RN07')?['responsableNombre']}\n\n**Entrevistas completas:** @{outputs('Datos_RN07')?['completas']} de @{outputs('Datos_RN07')?['previstas']}\n\n**Índice de adopción:** @{body('Leer_verificacion')?['vu_indiceadopcion']} %\n\n**Resultado:** @{body('Leer_verificacion')?['vu_resultado@OData.Community.Display.V1.FormattedValue']}\n\n**Sustento global:**\n\n@{coalesce(body('Leer_verificacion')?['vu_sustentoglobal'], '-')}\n\n**Oportunidades de mejora:**\n\n@{coalesce(body('Leer_verificacion')?['vu_oportunidadesconsolidadas'], '-')}\n\n**Recomendaciones:**\n\n@{coalesce(body('Leer_verificacion')?['vu_recomendacionesconsolidadas'], '-')}\n\n---\n\nLas entrevistas (respuestas, puntajes, sustentos e historial de cambios de puntaje) se pueden revisar en la app **Verificación de uso** → Catálogo → @{outputs('Datos_RN07')?['solucion']} → Historial de verificaciones → @{outputs('Datos_RN07')?['codigo']} → Revisión final.\n\nResponda **Aprobar** (la verificación queda Aprobada), **Observar** (vuelve al responsable para corregir) o **Rechazar**.",
                      "WebhookApprovalCreationInput/enableNotifications": true,
                      "WebhookApprovalCreationInput/enableReassignment": false
                    }
                  }
                },
                "Registrar_envio_revision_Piloto": {
                  "runAfter": {
                    "Solicitar_aprobacion_Piloto": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_notificacions",
                      "item/vu_name": "Solicitud de aprobación (Piloto) · @{outputs('Datos_RN07')?['codigo']}",
                      "item/vu_tiponotificacion": 100000001,
                      "item/vu_DestinatarioId@odata.bind": "/systemusers(@{outputs('Aprobador_Piloto')?['id']})",
                      "item/vu_canal": 100000000,
                      "item/vu_fechaenvio": "@body('Crear_aprobacion_Piloto')?['vu_fechasolicitud']",
                      "item/vu_estadoenvio": "@if(equals(actions('Solicitar_aprobacion_Piloto')?['status'], 'Failed'), 100000001, 100000000)",
                      "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{triggerOutputs()?['body/vu_verificacionid']})"
                    }
                  }
                },
                "Si_fallo_la_solicitud_Piloto": {
                  "actions": {
                    "Terminar_por_error_de_aprobacion_Piloto": {
                      "runAfter": {},
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Failed",
                        "runError": {
                          "code": "AprobacionNoCreada",
                          "message": "No se pudo crear la aprobación de nivel Piloto. La verificación sigue en su estado actual; corrija la causa y vuelva a enviar esta ejecución."
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Registrar_envio_revision_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@actions('Solicitar_aprobacion_Piloto')?['status']",
                          "Failed"
                        ]
                      }
                    ]
                  },
                  "type": "If",
                  "else": {
                    "actions": {}
                  }
                },
                "Respuesta_Piloto": {
                  "runAfter": {
                    "Si_fallo_la_solicitud_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(equals(actions('Solicitar_aprobacion_Piloto')?['status'], 'Succeeded'), coalesce(actions('Solicitar_aprobacion_Piloto')?['outputs']?['body']?['outcome'], 'Expirada'), 'Expirada')"
                },
                "Decision_Piloto": {
                  "runAfter": {
                    "Respuesta_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": {
                    "decision": "@if(equals(outputs('Respuesta_Piloto'), 'Aprobar'), 100000001, if(equals(outputs('Respuesta_Piloto'), 'Observar'), 100000002, if(equals(outputs('Respuesta_Piloto'), 'Rechazar'), 100000003, 100000000)))",
                    "texto": "@if(equals(outputs('Respuesta_Piloto'), 'Aprobar'), 'Aprobada', if(equals(outputs('Respuesta_Piloto'), 'Observar'), 'Observada', if(equals(outputs('Respuesta_Piloto'), 'Rechazar'), 'Rechazada', 'Pendiente')))",
                    "comentario": "@if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'Sin respuesta: la solicitud expiró a los 14 días y se canceló.', coalesce(actions('Solicitar_aprobacion_Piloto')?['outputs']?['body']?['responses']?[0]?['comments'], ''))",
                    "fechaDecision": "@coalesce(actions('Solicitar_aprobacion_Piloto')?['outputs']?['body']?['responses']?[0]?['responseDate'], utcNow())",
                    "approvalId": "@coalesce(actions('Solicitar_aprobacion_Piloto')?['outputs']?['body']?['name'], '')"
                  }
                },
                "Actualizar_aprobacion_Piloto": {
                  "runAfter": {
                    "Decision_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_aprobacions",
                      "recordId": "@body('Crear_aprobacion_Piloto')?['vu_aprobacionid']",
                      "item/vu_decision": "@outputs('Decision_Piloto')?['decision']",
                      "item/vu_comentario": "@outputs('Decision_Piloto')?['comentario']",
                      "item/vu_fechadecision": "@outputs('Decision_Piloto')?['fechaDecision']",
                      "item/vu_approvalid": "@outputs('Decision_Piloto')?['approvalId']"
                    }
                  }
                },
                "Fijar_estado_tras_Piloto": {
                  "runAfter": {
                    "Actualizar_aprobacion_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varEstadoFinal",
                    "value": "@if(equals(outputs('Respuesta_Piloto'), 'Aprobar'), 100000007, 100000005)"
                  }
                },
                "Avisar_decision_correo_Piloto": {
                  "runAfter": {
                    "Fijar_estado_tras_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{outputs('Datos_RN07')?['responsable']}",
                      "emailMessage/Subject": "Verificación @{outputs('Datos_RN07')?['codigo']}: @{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}",
                      "emailMessage/Body": "<p>Hola @{outputs('Datos_RN07')?['responsableNombre']}:</p><p>La aprobación de la verificación <b>@{outputs('Datos_RN07')?['codigo']}</b> (@{outputs('Datos_RN07')?['solucion']}) terminó con la decisión <b>@{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}</b>.</p><p><b>Comentario:</b> @{outputs('Decision_Piloto')?['comentario']}</p><p>@{if(equals(outputs('Respuesta_Piloto'), 'Aprobar'), 'La verificación queda Aprobada y se calculó la próxima verificación de la solución.', if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'La solicitud expiró sin respuesta: la verificación queda Observada para que pueda reenviarla.', 'La verificación queda Observada: revise los comentarios, corrija en la app y vuelva a enviarla.'))}</p>",
                      "emailMessage/Importance": "Normal"
                    }
                  }
                },
                "Registrar_decision_correo_Piloto": {
                  "runAfter": {
                    "Avisar_decision_correo_Piloto": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_notificacions",
                      "item/vu_name": "Verificación @{outputs('Datos_RN07')?['codigo']} · nivel Piloto: @{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}",
                      "item/vu_tiponotificacion": 100000002,
                      "item/vu_DestinatarioId@odata.bind": "/systemusers(@{outputs('Datos_RN07')?['responsableId']})",
                      "item/vu_canal": 100000000,
                      "item/vu_fechaenvio": "@utcNow()",
                      "item/vu_estadoenvio": "@if(equals(actions('Avisar_decision_correo_Piloto')?['status'], 'Succeeded'), 100000000, 100000001)",
                      "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{triggerOutputs()?['body/vu_verificacionid']})"
                    }
                  }
                },
                "Tarjeta_decision_Piloto": {
                  "runAfter": {
                    "Fijar_estado_tras_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": {
                    "type": "AdaptiveCard",
                    "version": "1.4",
                    "body": [
                      {
                        "type": "TextBlock",
                        "size": "Medium",
                        "weight": "Bolder",
                        "wrap": true,
                        "text": "Verificación @{outputs('Datos_RN07')?['codigo']}: @{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}"
                      },
                      {
                        "type": "FactSet",
                        "facts": [
                          {
                            "title": "Solución",
                            "value": "@{outputs('Datos_RN07')?['solucion']}"
                          },
                          {
                            "title": "Decisión",
                            "value": "@{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}"
                          },
                          {
                            "title": "Comentario",
                            "value": "@{outputs('Decision_Piloto')?['comentario']}"
                          }
                        ]
                      },
                      {
                        "type": "TextBlock",
                        "wrap": true,
                        "text": "@{if(equals(outputs('Respuesta_Piloto'), 'Aprobar'), 'La verificación queda Aprobada y se calculó la próxima verificación de la solución.', if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'La solicitud expiró sin respuesta: la verificación queda Observada para que pueda reenviarla.', 'La verificación queda Observada: revise los comentarios, corrija en la app y vuelva a enviarla.'))}"
                      }
                    ]
                  }
                },
                "Avisar_decision_Teams_Piloto": {
                  "runAfter": {
                    "Tarjeta_decision_Piloto": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_teams",
                      "operationId": "PostCardToConversation",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Chat with Flow bot",
                      "body/recipient": "@{outputs('Datos_RN07')?['responsable']}",
                      "body/messageBody": "@{string(outputs('Tarjeta_decision_Piloto'))}"
                    }
                  }
                },
                "Registrar_decision_Teams_Piloto": {
                  "runAfter": {
                    "Avisar_decision_Teams_Piloto": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_notificacions",
                      "item/vu_name": "Verificación @{outputs('Datos_RN07')?['codigo']} · nivel Piloto: @{if(equals(outputs('Respuesta_Piloto'), 'Expirada'), 'sin respuesta (expirada)', toLower(outputs('Decision_Piloto')?['texto']))}",
                      "item/vu_tiponotificacion": 100000002,
                      "item/vu_DestinatarioId@odata.bind": "/systemusers(@{outputs('Datos_RN07')?['responsableId']})",
                      "item/vu_canal": 100000001,
                      "item/vu_fechaenvio": "@utcNow()",
                      "item/vu_estadoenvio": "@if(equals(actions('Avisar_decision_Teams_Piloto')?['status'], 'Succeeded'), 100000000, 100000001)",
                      "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{triggerOutputs()?['body/vu_verificacionid']})"
                    }
                  }
                }
              },
              "runAfter": {
                "Aprobador_Piloto": [
                  "Succeeded"
                ]
              },
              "type": "Scope"
            }
          },
          "runAfter": {
            "Datos_RN07": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Datos_RN07')?['completas']",
                  "@outputs('Datos_RN07')?['previstas']"
                ]
              },
              {
                "not": {
                  "equals": [
                    "@empty(outputs('Datos_RN07')?['aprobadorPilotoId'])",
                    true
                  ]
                }
              }
            ]
          },
          "type": "If",
          "else": {
            "actions": {
              "Fijar_estado_En_evaluacion": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "varEstadoFinal",
                  "value": 100000003
                }
              },
              "Fijar_motivo_devolucion": {
                "runAfter": {
                  "Fijar_estado_En_evaluacion": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varMotivoDevolucion",
                  "value": "@if(equals(outputs('Datos_RN07')?['completas'], outputs('Datos_RN07')?['previstas']), 'No hay aprobadora del piloto registrada.', concat('Hay ', string(outputs('Datos_RN07')?['completas']), ' entrevistas completas y se prevén ', string(outputs('Datos_RN07')?['previstas']), '. Para enviar a revisión deben coincidir (RN-07).'))"
                }
              }
            }
          }
        },
        "Leer_verificacion_cierre": {
          "runAfter": {
            "Si_cumple_RN07": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_verificacions",
              "recordId": "@triggerOutputs()?['body/vu_verificacionid']",
              "$select": "vu_estado"
            }
          }
        },
        "Si_cambia_el_estado": {
          "actions": {
            "Si_queda_Aprobada": {
              "actions": {
                "Calcular_proxima_VU": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@addToTime(convertFromUtc(utcNow(), 'SA Pacific Standard Time', 'yyyy-MM-dd'), coalesce(body('Leer_solucion')?['vu_periodicidadmeses'], 6), 'Month', 'yyyy-MM-dd')"
                },
                "Actualizar_proxima_VU_solucion": {
                  "runAfter": {
                    "Calcular_proxima_VU": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_solucions",
                      "recordId": "@body('Leer_verificacion')?['_vu_solucionid_value']",
                      "item/vu_proximavu": "@outputs('Calcular_proxima_VU')"
                    }
                  }
                },
                "Marcar_Aprobada": {
                  "runAfter": {
                    "Actualizar_proxima_VU_solucion": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "vu_verificacions",
                      "recordId": "@triggerOutputs()?['body/vu_verificacionid']",
                      "item/vu_estado": 100000007,
                      "item/vu_fechaaprobacion": "@utcNow()"
                    }
                  }
                }
              },
              "runAfter": {},
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('varEstadoFinal')",
                      100000007
                    ]
                  }
                ]
              },
              "type": "If",
              "else": {
                "actions": {
                  "Actualizar_estado_verificacion": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "vu_verificacions",
                        "recordId": "@triggerOutputs()?['body/vu_verificacionid']",
                        "item/vu_estado": "@variables('varEstadoFinal')"
                      }
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Leer_verificacion_cierre": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "or": [
                  {
                    "equals": [
                      "@body('Leer_verificacion_cierre')?['vu_estado']",
                      100000004
                    ]
                  },
                  {
                    "equals": [
                      "@body('Leer_verificacion_cierre')?['vu_estado']",
                      100000006
                    ]
                  }
                ]
              },
              {
                "not": {
                  "equals": [
                    "@body('Leer_verificacion_cierre')?['vu_estado']",
                    "@variables('varEstadoFinal')"
                  ]
                }
              }
            ]
          },
          "type": "If",
          "else": {
            "actions": {}
          }
        },
        "Si_fue_devuelta_por_RN07": {
          "actions": {
            "Avisar_devolucion_al_responsable": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@{outputs('Datos_RN07')?['responsable']}",
                  "emailMessage/Subject": "Verificación @{outputs('Datos_RN07')?['codigo']} devuelta a evaluación",
                  "emailMessage/Body": "<p>Hola @{outputs('Datos_RN07')?['responsableNombre']}:</p><p>La verificación <b>@{outputs('Datos_RN07')?['codigo']}</b> (@{outputs('Datos_RN07')?['solucion']}) no se pudo enviar a revisión y volvió a <b>En evaluación</b>.</p><p><b>Motivo:</b> @{variables('varMotivoDevolucion')}</p><p>Corrija en la app <i>Verificación de uso</i> y vuelva a enviarla.</p>",
                  "emailMessage/Importance": "Normal"
                }
              }
            },
            "Registrar_aviso_devolucion": {
              "runAfter": {
                "Avisar_devolucion_al_responsable": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_notificacions",
                  "item/vu_name": "Verificación @{outputs('Datos_RN07')?['codigo']} devuelta a evaluación",
                  "item/vu_tiponotificacion": 100000001,
                  "item/vu_DestinatarioId@odata.bind": "/systemusers(@{outputs('Datos_RN07')?['responsableId']})",
                  "item/vu_canal": 100000000,
                  "item/vu_fechaenvio": "@utcNow()",
                  "item/vu_estadoenvio": "@if(equals(actions('Avisar_devolucion_al_responsable')?['status'], 'Succeeded'), 100000000, 100000001)",
                  "item/vu_VerificacionId@odata.bind": "/vu_verificacions(@{triggerOutputs()?['body/vu_verificacionid']})"
                }
              }
            }
          },
          "runAfter": {
            "Si_cambia_el_estado": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@variables('varEstadoFinal')",
                  100000003
                ]
              },
              {
                "equals": [
                  "@body('Leer_verificacion_cierre')?['vu_estado']",
                  100000004
                ]
              }
            ]
          },
          "type": "If",
          "else": {
            "actions": {}
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
