{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "vu_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Al_crear_o_cambiar_estado_de_una_verificacion": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "vu_verificacion",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "vu_estado",
              "subscriptionRequest/runas": 3
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Hoy_Lima": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@convertFromUtc(utcNow(), 'SA Pacific Standard Time', 'yyyy-MM-dd')"
        },
        "Leer_solucion": {
          "runAfter": {
            "Hoy_Lima": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_solucions",
              "recordId": "@triggerOutputs()?['body/_vu_solucionid_value']",
              "$select": "vu_solucionid,vu_estadovu,vu_proximavu,_vu_ultimaverificacionid_value"
            }
          }
        },
        "Listar_ultima_verificacion": {
          "runAfter": {
            "Leer_solucion": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "vu_verificacions",
              "$select": "vu_verificacionid,vu_estado",
              "$filter": "_vu_solucionid_value eq @{body('Leer_solucion')?['vu_solucionid']}",
              "$orderby": "createdon desc",
              "$top": 1
            }
          }
        },
        "Ultima_verificacion": {
          "runAfter": {
            "Listar_ultima_verificacion": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "id": "@first(body('Listar_ultima_verificacion')?['value'])?['vu_verificacionid']",
            "estado": "@first(body('Listar_ultima_verificacion')?['value'])?['vu_estado']"
          }
        },
        "Es_vigente": {
          "runAfter": {
            "Ultima_verificacion": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@greaterOrEquals(int(replace(take(concat(coalesce(body('Leer_solucion')?['vu_proximavu'], ''), '0000-00-00'), 10), '-', '')), int(replace(outputs('Hoy_Lima'), '-', '')))"
        },
        "EstadoVU_calculado": {
          "runAfter": {
            "Es_vigente": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(or(equals(outputs('Ultima_verificacion')?['estado'], null), equals(outputs('Ultima_verificacion')?['estado'], 100000000), equals(outputs('Ultima_verificacion')?['estado'], 100000008)), 100000000, if(equals(outputs('Ultima_verificacion')?['estado'], 100000001), 100000001, if(or(equals(outputs('Ultima_verificacion')?['estado'], 100000002), equals(outputs('Ultima_verificacion')?['estado'], 100000003), equals(outputs('Ultima_verificacion')?['estado'], 100000005)), 100000002, if(or(equals(outputs('Ultima_verificacion')?['estado'], 100000004), equals(outputs('Ultima_verificacion')?['estado'], 100000006)), 100000003, if(outputs('Es_vigente'), 100000004, 100000000)))))"
        },
        "Si_hay_cambios": {
          "actions": {
            "Actualizar_solucion": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "vu_solucions",
                  "recordId": "@body('Leer_solucion')?['vu_solucionid']",
                  "item/vu_estadovu": "@outputs('EstadoVU_calculado')",
                  "item/vu_UltimaVerificacionId@odata.bind": "/vu_verificacions(@{outputs('Ultima_verificacion')?['id']})"
                }
              }
            }
          },
          "runAfter": {
            "EstadoVU_calculado": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@empty(outputs('Ultima_verificacion')?['id'])",
                    true
                  ]
                }
              },
              {
                "or": [
                  {
                    "not": {
                      "equals": [
                        "@outputs('EstadoVU_calculado')",
                        "@body('Leer_solucion')?['vu_estadovu']"
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@toLower(coalesce(body('Leer_solucion')?['_vu_ultimaverificacionid_value'], ''))",
                        "@toLower(outputs('Ultima_verificacion')?['id'])"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "type": "If",
          "else": {
            "actions": {}
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
