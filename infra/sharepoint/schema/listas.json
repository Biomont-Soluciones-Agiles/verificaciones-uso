{
  "schemaVersion": "1.0",
  "source": "docs/diseno-verificacion-uso.md (§2.1, §2.3, §2.4, §2.5, §3.6)",
  "notes": [
    "Las listas están en orden de dependencia: catálogos → VU_Verificaciones → hijas → biblioteca.",
    "name = nombre interno de la lista (segmento de la URL). title = título visible en español (el script solo lo aplica con -TitulosEnEspanol; por defecto el título es igual a name).",
    "internalName se crea primero como DisplayName (ASCII, sin tildes) y después se cambia el nombre visible a displayName.",
    "indexed = true en las columnas 🔎 del diseño y, además, en todo Lookup con relationshipBehavior Cascade/Restrict (SharePoint exige índice para exigir la relación).",
    "relationshipBehavior: Cascade = eliminación en cascada; Restrict = restringir eliminación; None = sin exigir relación.",
    "enableVersioning = false significa 'el script no lo modifica' (se deja el valor predeterminado de SharePoint)."
  ],
  "site": {
    "defaultUrl": "https://biomont.sharepoint.com/sites/VerificacionUso",
    "title": "Verificación de uso",
    "lcid": 3082
  },
  "security": {
    "groups": [
      {
        "name": "VU Lectores",
        "description": "Consulta del catálogo de soluciones digitales (solo lectura de catálogos).",
        "siteRole": "Read"
      },
      {
        "name": "VU Responsables",
        "description": "Responsables de verificación de uso: colaboran en verificaciones, entrevistas, respuestas, puntajes y evidencias.",
        "siteRole": "Read"
      },
      {
        "name": "VU Aprobadores",
        "description": "Aprobadoras de la verificación de uso: lectura (deciden en Power Automate Approvals).",
        "siteRole": "Read"
      },
      {
        "name": "VU Administradores",
        "description": "Administradores de la aplicación Verificación de uso: control total.",
        "siteRole": "FullControl"
      }
    ],
    "serviceAccountRole": "Edit",
    "roleTypeKinds": {
      "Read": "Reader",
      "Contribute": "Contributor",
      "Edit": "Editor",
      "FullControl": "Administrator"
    },
    "profiles": {
      "Catalogo": {
        "description": "Catálogos: heredan los permisos del sitio (Lectores/Responsables/Aprobadores = Leer, Administradores = Control total).",
        "breakInheritance": false,
        "roles": []
      },
      "Transaccional": {
        "description": "Transaccionales: permisos únicos. Responsables = Colaborar, Aprobadores = Leer, Administradores = Control total, Lectores sin acceso.",
        "breakInheritance": true,
        "roles": [
          {
            "group": "VU Lectores",
            "role": null
          },
          {
            "group": "VU Responsables",
            "role": "Contribute"
          },
          {
            "group": "VU Aprobadores",
            "role": "Read"
          },
          {
            "group": "VU Administradores",
            "role": "FullControl"
          }
        ]
      },
      "AprobacionesNotificaciones": {
        "description": "Aprobaciones y notificaciones: permisos únicos. Responsables y Aprobadores = Leer, Administradores = Control total, Lectores sin acceso.",
        "breakInheritance": true,
        "roles": [
          {
            "group": "VU Lectores",
            "role": null
          },
          {
            "group": "VU Responsables",
            "role": "Read"
          },
          {
            "group": "VU Aprobadores",
            "role": "Read"
          },
          {
            "group": "VU Administradores",
            "role": "FullControl"
          }
        ]
      }
    }
  },
