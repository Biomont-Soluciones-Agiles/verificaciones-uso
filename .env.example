# Copia este archivo como .env.local para cambiar la configuración local (no se versiona).

# Origen de datos de la app:
#   dataverse -> tablas vu_* del entorno a través de los servicios generados en src/generated/
#                (por defecto; los datos solo llegan dentro del host de Power Apps: usa la URL
#                "Local Play" que imprime `npm run dev`, no http://localhost:3000 directamente)
#   mock      -> repositorios en memoria con los datos del prototipo (sin conexión y pruebas)
VITE_DATA_SOURCE=dataverse
