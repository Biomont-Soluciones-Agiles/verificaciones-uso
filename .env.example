# Copia este archivo como .env.local para cambiar la configuración local (no se versiona).

# Origen de datos de la app:
#   mock        -> repositorios en memoria con los datos del prototipo (por defecto)
#   sharepoint  -> servicios generados por `pac code add-data-source` (requiere las listas VU_* y la conexión)
VITE_DATA_SOURCE=mock
